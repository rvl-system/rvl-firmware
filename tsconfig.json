{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // Node runs this file directly by stripping types rather than compiling,
    // which erases annotations without transforming anything else
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["project.ts"]
}
